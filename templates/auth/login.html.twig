{% extends "base.html.twig" %}

{% block title %}Log in | Contact Manager{% endblock %}
{% block header %}{% include "auth/nav.html.twig" %}{% endblock %}

{% block content %}
  <section aria-labelledby="auth-heading" class="mx-auto max-w-sm pt-10 sm:pt-16">
    <h1 id="auth-heading" class="text-2xl font-semibold tracking-tight">Welcome back</h1>
    <p class="mt-2 text-sm leading-6 text-zinc-600">Log in to your Contact Manager account.</p>

    <form action="/api/auth/login" method="post" data-auth-form data-registration="false" novalidate data-redirect="/" data-pending="Logging in..." class="mt-8 space-y-5">
      <div>
        <label for="email" class="block text-sm font-medium">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" aria-describedby="email-error" required class="mt-2 block h-11 w-full rounded-lg border border-zinc-300 bg-white px-3 text-base text-zinc-950 transition-colors duration-150 hover:border-zinc-400 focus:border-zinc-950 focus:outline-2 focus:outline-offset-2 focus:outline-zinc-950">
        <p id="email-error" data-field-error aria-live="polite" class="mt-2 text-sm text-red-700 empty:hidden"></p>
      </div>
      {% include "auth/password.html.twig" with { registration: false } %}
      <p data-form-error role="alert" aria-atomic="true" class="text-sm leading-6 text-red-700 empty:my-0"></p>
      <button type="submit" class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-zinc-950 px-4 text-sm font-medium text-white transition-colors duration-150 hover:bg-zinc-800 active:bg-zinc-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-950 disabled:cursor-wait disabled:bg-zinc-400">Log in</button>
    </form>

    <p class="mt-6 text-sm text-zinc-600">Don’t have an account? <a href="/register" class="rounded-sm font-medium text-zinc-950 underline underline-offset-4 hover:text-zinc-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-950">Sign up</a></p>
  </section>
{% endblock %}

{% block scripts %}
  <script type="module" src="/assets/js/auth.js"></script>
{% endblock %}

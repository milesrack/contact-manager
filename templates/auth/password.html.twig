<div>
  <label for="password" class="block text-sm font-medium">Password</label>
  <div class="relative mt-2">
    <input id="password" name="password" type="password" autocomplete="{{ registration ? 'new-password' : 'current-password' }}" {% if registration %}data-min-length="{{ password_min_length }}"{% endif %} aria-describedby="{% if registration %}password-hint {% endif %}password-error" required class="block h-11 w-full rounded-lg border border-zinc-300 bg-white pl-3 pr-12 text-base text-zinc-950 transition-colors duration-150 hover:border-zinc-400 focus:border-zinc-950 focus:outline-2 focus:outline-offset-2 focus:outline-zinc-950">
    <button type="button" data-password-toggle aria-controls="password" aria-label="Show password" hidden class="absolute inset-y-0 right-0 w-11 rounded-r-lg text-zinc-600 hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-950">
      <svg data-eye aria-hidden="true" class="mx-auto size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
      <svg data-eye-off aria-hidden="true" hidden class="mx-auto size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 3 18 18M10.6 5.1A12 12 0 0 1 12 5c6.5 0 10 7 10 7a18 18 0 0 1-3 3.8M6.2 6.2A21 21 0 0 0 2 12s3.5 7 10 7a13 13 0 0 0 5.8-1.8M10 10a3 3 0 0 0 4 4" /></svg>
    </button>
  </div>
  {% if registration %}
    <p id="password-hint" class="mt-2 text-sm text-zinc-600">Password must be at least {{ password_min_length }} characters.</p>
  {% endif %}
  <p id="password-error" data-field-error aria-live="polite" class="mt-2 text-sm text-red-700 empty:hidden"></p>
</div>

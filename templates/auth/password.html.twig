<div>
  <label for="password" class="block text-sm font-medium">Password</label>
  <div class="relative mt-2">
    <input id="password" name="password" type="password" autocomplete="{{ registration ? 'new-password' : 'current-password' }}" {% if registration %}data-min-length="{{ password_min_length }}"{% endif %} aria-describedby="{% if registration %}password-hint {% endif %}password-error" required class="block h-11 w-full rounded-lg border border-zinc-300 bg-white pl-3 pr-20 text-base text-zinc-950 transition-colors duration-150 hover:border-zinc-400 focus:border-zinc-950 focus:outline-2 focus:outline-offset-2 focus:outline-zinc-950">
    <button type="button" data-password-toggle aria-controls="password" aria-label="Show password" hidden class="absolute inset-y-0 right-0 rounded-r-lg px-4 text-sm font-medium text-zinc-600 hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-950">Show</button>
  </div>
  {% if registration %}
    <p id="password-hint" class="mt-2 text-sm text-zinc-600">Password must be at least {{ password_min_length }} characters.</p>
  {% endif %}
  <p id="password-error" data-field-error aria-live="polite" class="mt-2 text-sm text-red-700 empty:hidden"></p>
</div>

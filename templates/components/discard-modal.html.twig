<dialog data-discard-dialog aria-labelledby="discard-title" aria-describedby="discard-description" class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-sm rounded-xl border border-zinc-200 bg-white p-6 text-zinc-950 backdrop:bg-zinc-950/30">
  <h2 id="discard-title" class="text-lg font-semibold tracking-tight">Discard changes?</h2>
  <p id="discard-description" class="mt-3 text-sm leading-6 text-zinc-600">Your changes haven’t been saved.</p>
  <div class="mt-6 flex justify-end gap-2">
    <button type="button" data-keep-editing autofocus class="btn-secondary">Keep editing</button>
    <button type="button" data-discard class="btn-danger">Discard</button>
  </div>
</dialog>

<dialog data-delete-dialog aria-labelledby="delete-title" aria-describedby="delete-description" class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-sm rounded-xl border border-zinc-200 bg-white p-6 text-zinc-950 backdrop:bg-zinc-950/30">
  <form data-delete-form>
    <h2 id="delete-title" class="text-lg font-semibold tracking-tight">Delete contact?</h2>
    <p id="delete-description" class="mt-3 text-sm leading-6 break-words text-zinc-600">Are you sure you want to delete <span data-delete-name class="font-medium text-zinc-950"></span>? This cannot be undone.</p>
    <p data-form-error role="alert" aria-atomic="true" class="mt-3 text-sm text-red-700"></p>
    <div class="mt-6 flex justify-end gap-2">
      <button type="button" data-close autofocus class="btn-secondary">Cancel</button>
      <button type="submit" class="btn-danger">Delete</button>
    </div>
  </form>
</dialog>

{
  "name": "contact-manager",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint public --no-error-on-unmatched-pattern",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:workflows": "node --test tests/dependabot-auto-merge.test.mjs",
    "check": "npm run lint && npm run format:check && npm run test:workflows && npm run build",
    "build": "tailwindcss -i ./assets/css/app.css -o ./public/assets/css/app.css --minify",
    "dev": "tailwindcss -i ./assets/css/app.css -o ./public/assets/css/app.css --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}
